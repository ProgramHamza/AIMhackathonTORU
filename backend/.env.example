# Copy this file to backend/.env and fill in your keys. .env is gitignored; never commit it.

# Claude (cloud). With a key, Claude answers and local Ollama is the fallback.
ANTHROPIC_API_KEY=

# auto (default) | anthropic | ollama
LLM_PROVIDER=auto
# Claude model for the prompt-analysis step (small and fast by design)
LLM_MODEL=claude-haiku-5-5

# Local fallback via Ollama
OLLAMA_MODEL=mistral:latest
# 2048 fits Mistral 7B into ~4.3 GB of free RAM; raise it if the machine has more memory
OLLAMA_NUM_CTX=2048
OLLAMA_HOST=http://127.0.0.1:11434

# Remarker
# Folder with patient.json and documents/ (the challenge data; never commit it)
PATIENT_DIR=
# Embedding model (free tier: ~100 texts per minute; the first index build paces itself)
EMBED_MODEL=gemini-embedding-2
# JINA_API_KEY=   optional reranker; measured gain on our checks: none, so it can stay empty

# More Gemini keys: requests rotate to the next key when one hits its free-tier limit
# GEMINI_API_KEY_2=

# Prompt analysis (block 5). Defaults are the best measured setup: graph only, no model call.
# PROMPT_LLM=off          # off | auto (Gemini for unknown words) | always
# PROMPT_EMBEDDINGS=off   # off | jina | gemini (embedding step for unknown words)
# EMBED_PROVIDER=jina     # embedder used by the embedding step when it is on

# Security
# 32-byte key (base64 or hex) for the encrypted caches; leave empty to let the app create
# backend/.cache/.data_key on first run. ENCRYPT_AT_REST=0 writes plain caches (debugging only).
DATA_KEY=
ENCRYPT_AT_REST=1
